; RUN: %tpde_test --run-until=analyzer --precise-liveness --print-spills %s | FileCheck %s --dump-input always

define @simple(%a, %b) {
entry:
  ret %a
}
; arguments + variable > regs

define @simple_reg_pressure(%a, %b) {
entry:
  %d = add %a, %b
  %e = add %a, %a
  ret %d
}

define @unused_reg_pressure() {
entry:
  %a =
  %b =
  %c =
  %d =
  %e =
  ret %d
}

define @used_reg_pressure() {
entry:
  %a =
  %b =
  %aa = add %a, %a
  %bb = add %b, %b
  %cc = add %a, %a
  ret %aa
}

define @too_much() {
entry:
  %a =
  %b =
  %aa = add %a, %a
  %bb = add %b, %b
  %cc = add %a, %bb
  %dd = add %b, %b
  ret %aa
}

define @too_much_results() {
entry:
  %a =
  %b =
  %c =
  %ab = add %a, %b
  %ac = add %a, %c
  %bc = add %b, %c
  ret %ab
}
