; RUN: %tpde_test --run-until=analyzer --print-phi-webs %s | FileCheck %s --dump-input always

; CHECK: Phi Webs for simple
; CHECK-NEXT: web 0: { (0, a), (4, c) }
; CHECK-NEXT: web 1: { (1, const), (3, b) }
; CHECK-NEXT: End Phi Webs
simple(%a) {
entry:
  %const =
  jump ^loop
loop:
  %b = phi [^entry, %const], [^loop, %e]
  %c = phi [^entry, %a], [^loop, %f]
  %d = %c
  %e = %b, %d
  %f = %c
  jump ^loop, ^ret
ret:
  %ret = %b
  terminate
}

; CHECK: Phi Webs for singleton
; CHECK-NEXT: web 0: { (0, a), (4, p) }
; CHECK-NEXT: End Phi Webs
singleton(%a) {
entry:
  jump ^left, ^right
left:
  jump ^merge
right:
  jump ^merge
merge:
  %p = phi [^left, %a], [^right, %a]
  ret %p
}

; CHECK: Phi Webs for overlap
; CHECK-NEXT: End Phi Webs
overlap(%a) {
entry:
  jump ^left, ^right
left:
  jump ^merge
right:
  jump ^merge
merge:
  %p = phi [^left, %a], [^right, %a]
  %use = %a, %p
  ret %use
}

; CHECK: Phi Webs for live_overlap_chain
; CHECK-NEXT: End Phi Webs
live_overlap_chain(%a) {
entry:
  %init =
  jump ^loop
loop:
  %p = phi [^entry, %a], [^loop, %next]
  %carry = %a, %p
  %next = %p
  jump ^loop, ^ret
ret:
  ret %carry
}

; CHECK: Phi Webs for same_block_phi
; CHECK-NEXT: web 0: { (0, a), (5, p1) }
; CHECK-NEXT: web 1: { (1, b), (6, p2) }
; CHECK-NEXT: End Phi Webs
same_block_phi(%a, %b) {
entry:
  jump ^left, ^right
left:
  jump ^merge
right:
  jump ^merge
merge:
  %p1 = phi [^left, %a], [^right, %b]
  %p2 = phi [^left, %a], [^right, %b]
  %r = %p1, %p2
  ret %r
}

; CHECK: Phi Webs for same_block_phi_2
; CHECK-NEXT: web 0: { (0, a), (5, p1) }
; CHECK-NEXT: web 1: { (1, b), (6, p2) }
; CHECK-NEXT: End Phi Webs
same_block_phi_2(%a, %b) {
entry:
  jump ^left, ^right
left:
  jump ^merge
right:
  jump ^merge
merge:
  %p1 = phi [^left, %a], [^right, %b]
  %p2 = phi [^left, %a], [^right, %b]
  terminate
}

; CHECK: Phi Webs for half_chain
; CHECK-NEXT: web 2: { (2, init), (4, p1), (8, p2) }
; CHECK-NEXT: End Phi Webs
half_chain(%a, %b) {
entry:
  %init =
  jump ^premerge
premerge:
  %p1 = phi [^entry, %init]
   jump ^left, ^right
left:
  jump ^merge
right:
  jump ^merge
merge:

  %p2 = phi [^left, %p1], [^right, %a]
  terminate
}
