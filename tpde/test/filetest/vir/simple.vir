  op defs=%v0@r8
  op uses=%v0@r7

; CHECK Function phi_cycle is valid
function phi_cycle

block b0:
  op defs=%v2147483661@r3
  op defs=%v2147483662@r12
  jmp b1

block b1:
  phi %v1@r3 [b0, %v4294967295@r255, b1, %v2@r12]
  phi %v2@r12 [b0, %v4294967295@r255, b1, %v1@r3]
  edit regmove r12 -> r0 4b
  edit regmove r3 -> r12 4b
  edit regmove r0 -> r3 4b
  jmp b1

edge b1 -> b1:
  parallel %v2@r12 -> %v1@r3, %v1@r3 -> %v2@r12

