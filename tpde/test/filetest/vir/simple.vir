; RUN: %vir_verify %s | FileCheck %s --dump-input always

; CHECK: Function correct is valid
function correct

block b0:
  op defs=%v0@r7
  op uses=%v0@r7

; CHECK: Function wrong verification failed: Operation in b0 of function wrong: register r7 not in state (expected v0 with number 0)
function wrong
