; RUN: tpde_test --target=aarch64 %s --no-fixed-assignments | llvm-objdump -d -r --no-show-raw-insn - | FileCheck %s

define @tbz(%a) {
; CHECK-LABEL: <tbz>:
; CHECK:         20: sub sp, sp, #0xa0
; CHECK-NEXT:    24: stp x29, x30, [sp]
; CHECK-NEXT:    28: mov x29, sp
; CHECK-NEXT:    2c: nop
; CHECK-NEXT:    30: tbnz x0, #0x2f, 0x3c <tbz+0x1c>
; CHECK-NEXT:    34: sub x1, x0, x0
; CHECK-NEXT:    38: b 0x40 <tbz+0x20>
; CHECK-NEXT:    3c: add x1, x0, x0
; CHECK-NEXT:    40: ldp x29, x30, [sp]
; CHECK-NEXT:    44: add sp, sp, #0xa0
; CHECK-NEXT:    48: ret
entry:
  tbz %a, ^tgt1, ^tgt2, 47
tgt1:
  %s1 = sub %a, %a
  br ^ret
tgt2:
  %s2 = add %a, %a
  br ^ret
ret:
  terminate
}

define @tbz_small(%a) {
; CHECK-LABEL: <tbz_small>:
; CHECK:         70: sub sp, sp, #0xa0
; CHECK-NEXT:    74: stp x29, x30, [sp]
; CHECK-NEXT:    78: mov x29, sp
; CHECK-NEXT:    7c: nop
; CHECK-NEXT:    80: tbnz x0, #0x2f, 0x87c <tbz_small+0x80c>
; CHECK-NEXT:    84: b 0x874 <tbz_small+0x804>
; CHECK-NEXT:     ...
; CHECK-NEXT:    874: sub x1, x0, x0
; CHECK-NEXT:    878: b 0x880 <tbz_small+0x810>
; CHECK-NEXT:    87c: add x1, x0, x0
; CHECK-NEXT:    880: ldp x29, x30, [sp]
; CHECK-NEXT:    884: add sp, sp, #0xa0
; CHECK-NEXT:    888: ret
entry:
  tbz %a, ^tgt1, ^tgt2, 47
tgt1:
  zerofill 0x7f0
  %s1 = sub %a, %a
  br ^ret
tgt2:
  %s2 = add %a, %a
  br ^ret
ret:
  terminate
}

; Medium-sized tbz; veener space is allocated but not used
define @tbz_medium(%a) {
; CHECK-LABEL: <tbz_medium>:
; CHECK:         8b0: sub sp, sp, #0xa0
; CHECK-NEXT:    8b4: stp x29, x30, [sp]
; CHECK-NEXT:    8b8: mov x29, sp
; CHECK-NEXT:    8bc: nop
; CHECK-NEXT:    8c0: tbnz x0, #0x2f, 0x87d4 <tbz_medium+0x7f24>
; CHECK-NEXT:    8c4: b 0x8cc <tbz_medium+0x1c>
; CHECK-NEXT:    8c8: udf #0x0
; CHECK-NEXT:    8cc: b 0x87cc <tbz_medium+0x7f1c>
; CHECK-NEXT:     ...
; CHECK-NEXT:    87cc: sub x1, x0, x0
; CHECK-NEXT:    87d0: b 0x87d8 <tbz_medium+0x7f28>
; CHECK-NEXT:    87d4: add x1, x0, x0
; CHECK-NEXT:    87d8: ldp x29, x30, [sp]
; CHECK-NEXT:    87dc: add sp, sp, #0xa0
; CHECK-NEXT:    87e0: ret
entry:
  tbz %a, ^tgt1, ^tgt2, 47
tgt1:
  zerofill 0x7f00
  %s1 = sub %a, %a
  br ^ret
tgt2:
  %s2 = add %a, %a
  br ^ret
ret:
  terminate
}

; Large-sized tbz; veener must be used
define @tbz_large(%a) {
; CHECK-LABEL: <tbz_large>:
; CHECK:         8810: sub sp, sp, #0xa0
; CHECK-NEXT:    8814: stp x29, x30, [sp]
; CHECK-NEXT:    8818: mov x29, sp
; CHECK-NEXT:    881c: nop
; CHECK-NEXT:    8820: tbnz x0, #0x2f, 0x8828 <tbz_large+0x18>
; CHECK-NEXT:    8824: b 0x882c <tbz_large+0x1c>
; CHECK-NEXT:    8828: b 0x10834 <tbz_large+0x8024>
; CHECK-NEXT:    882c: b 0x1082c <tbz_large+0x801c>
; CHECK-NEXT:     ...
; CHECK-NEXT:    1082c: sub x1, x0, x0
; CHECK-NEXT:    10830: b 0x10838 <tbz_large+0x8028>
; CHECK-NEXT:    10834: add x1, x0, x0
; CHECK-NEXT:    10838: ldp x29, x30, [sp]
; CHECK-NEXT:    1083c: add sp, sp, #0xa0
; CHECK-NEXT:    10840: ret
entry:
  tbz %a, ^tgt1, ^tgt2, 47
tgt1:
  zerofill 0x8000
  %s1 = sub %a, %a
  br ^ret
tgt2:
  %s2 = add %a, %a
  br ^ret
ret:
  terminate
}
